{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "alexkramse/filament-openapi-docs",
    "description": "Render Scramble OpenAPI documentation inside a Filament panel.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Oleksandr Kramarenko",
            "homepage": "https://github.com/alexkramse",
            "role": "Developer"
        }
    ],
    "homepage": "https://github.com/alexkramse/filament-openapi-docs",
    "keywords": [
        "laravel",
        "filament",
        "openapi",
        "swagger",
        "scramble",
        "api",
        "documentation"
    ],
    "support": {
        "issues": "https://github.com/alexkramse/filament-openapi-docs/issues",
        "source": "https://github.com/alexkramse/filament-openapi-docs"
    },
    "autoload": {
        "psr-4": {
            "Alexkramse\\FilamentOpenapiDocs\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Alexkramse\\FilamentOpenapiDocs\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.2",
        "dedoc/scramble": "^0.13.30",
        "filament/filament": "^4.0 || ^5.0",
        "spatie/laravel-package-tools": "^1.16",
        "illuminate/contracts": "^11.0 || ^12.0 || ^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.10",
        "laravel/framework": "^11.28 || ^12.0 || ^13.0",
        "laravel/pint": "^1.29",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
        "pestphp/pest": "^3.0 || ^4.0",
        "pestphp/pest-plugin-laravel": "^3.0 || ^4.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Alexkramse\\FilamentOpenapiDocs\\FilamentOpenApiDocsServiceProvider"
            ]
        }
    },
    "scripts": {
        "pint": [
            "vendor/bin/pint"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
